# Local development environment variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and should NOT be committed

# Required: Your Midjourney API key
MIDJOURNEY_API_KEY=your_api_key_here

# Optional: Custom API endpoints (uncomment and modify if needed)
# MIDJOURNEY_API_ENDPOINT=https://api.midjourneyapi.io/v2/imagine
# MIDJOURNEY_API_STATUS_ENDPOINT=https://api.midjourneyapi.io/v2/status/{taskId}
